# Lokale Vorschau ohne Microsoft-Login und Datenbank (nur `next dev`)
NEXT_PUBLIC_INTRANET_DEMO=

# Supabase (Projekt "GRID AGENCY UG"); Service-Key nur serverseitig
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# hello@-Eingang: Client-Secret der Entra-App "GRID Intranet" (Anwendungs-
# berechtigung Mail.Read), Geheimnis für Graph-Benachrichtigungen, Vercel-Cron
MS_CLIENT_SECRET=
MAIL_WEBHOOK_SECRET=
CRON_SECRET=
# Öffentliche Produktions-URL für das Graph-Abo, z. B. https://intranet.grid-agency.de
INTRANET_URL=

# Einordnung Anfrage/Bewerbung und Kunden-Updates mit Claude (ohne Key:
# Stichwort-Regeln, keine Kunden-Updates)
ANTHROPIC_API_KEY=

# easybill (Kunden, Artikel, Serienrechnungen, Angebote)
EASYBILL_API_KEY=
# Bank (Finance → Bank) über Enable Banking: App-ID und privater Schlüssel
# (PEM, Zeilenumbrüche als \n erlaubt) aus dem Enable-Banking-Control-Panel
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
# Passwort-Tresor (Admin): 32 Byte base64, z. B. openssl rand -base64 32. Nie ändern.
VAULT_KEY=

# Meta Lead Ads (Facebook + Instagram)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# LinkedIn Lead Sync
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# Video-Calls unter meet.grid-agency.de: Verbindungszeichenfolge der Azure-
# Communication-Services-Ressource (Schlüssel). Ohne: Termine mit Teams-Link.
# Die Domain meet.grid-agency.de muss am Vercel-Projekt hängen.
ACS_CONNECTION_STRING=
# Optional, Standard https://meet.grid-agency.de
MEET_URL=

# Aufnahme und Transkript der Calls (alle drei Gruppen nötig, sonst keine Aufnahme)
# Event Grid: Communication-Services-Ressource → Ereignisse → Abo
# „Recording File Status Updated“ als Webhook auf
# https://intranet.grid-agency.de/api/webhooks/acs?key=<ACS_EVENTS_SECRET>
ACS_EVENTS_SECRET=
# Azure AI Speech (Fast Transcription): Schlüssel und Region, z. B. westeurope
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional statt Region: eigener Endpunkt, z. B. https://<name>.cognitiveservices.azure.com
AZURE_SPEECH_ENDPOINT=
# Azure OpenAI: Endpunkt, Schlüssel, Deployment-Name (z. B. gpt-4o), optional API-Version
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Marketing Hub (docs/marketing-hub.md): Canva, Meta-Posting, LinkedIn
# Community Management (eigene App), TikTok, SharePoint-Ablage, Agent-Zugang
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
META_APP_ID=
LINKEDIN_CM_CLIENT_ID=
LINKEDIN_CM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
SHAREPOINT_SITE=
AGENT_API_KEY=
