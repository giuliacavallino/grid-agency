# Lokale Vorschau ohne Microsoft-Login und Datenbank (nur `next dev`)
NEXT_PUBLIC_INTRANET_DEMO=

# Supabase (Projekt "GRID AGENCY UG"); Service-Key nur serverseitig
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# hello@-Eingang: Client-Secret der Entra-App "GRID Intranet" (Anwendungs-
# berechtigung Mail.Read), Geheimnis für Graph-Benachrichtigungen, Vercel-Cron
MS_CLIENT_SECRET=
MAIL_WEBHOOK_SECRET=
CRON_SECRET=
# Öffentliche Produktions-URL für das Graph-Abo, z. B. https://intranet.grid-agency.de
INTRANET_URL=

# Einordnung Anfrage/Bewerbung mit Claude (ohne Key: Stichwort-Regeln)
ANTHROPIC_API_KEY=

# easybill (Kunden, Artikel, Serienrechnungen, Angebote)
EASYBILL_API_KEY=
# Bank (Finance → Bank) über Enable Banking: App-ID und privater Schlüssel
# (PEM, Zeilenumbrüche als \n erlaubt) aus dem Enable-Banking-Control-Panel
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
# Passwort-Tresor (Admin): 32 Byte base64, z. B. openssl rand -base64 32. Nie ändern.
VAULT_KEY=

# Meta Lead Ads (Facebook + Instagram)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# LinkedIn Lead Sync
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
